<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="50%" stop-color="#1e1b4b"/>
      <stop offset="100%" stop-color="#090d16"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <linearGradient id="avatarGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#818cf8"/>
      <stop offset="100%" stop-color="#4f46e5"/>
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="800" fill="url(#bgGrad)"/>
  <circle cx="400" cy="400" r="320" fill="none" stroke="url(#accentGrad)" stroke-width="2" stroke-dasharray="10 15" opacity="0.3"/>
  <circle cx="400" cy="400" r="260" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.1"/>
  
  <!-- Developer Avatar Vector Graphic -->
  <g transform="translate(400, 370)">
    <!-- Shoulders / Body -->
    <path d="M-140,240 C-140,150 -80,130 0,130 C80,130 140,150 140,240 Z" fill="url(#avatarGrad)"/>
    <!-- Hoodie Accent Collar -->
    <path d="M-50,135 L0,180 L50,135 Z" fill="#312e81"/>
    
    <!-- Head / Face -->
    <circle cx="0" cy="-20" r="95" fill="#f8fafc"/>
    <path d="M-95,-20 C-95,-90 -60,-115 0,-115 C60,-115 95,-90 95,-20 Z" fill="#0f172a"/>
    
    <!-- Modern Glasses -->
    <rect x="-65" y="-35" width="50" height="35" rx="8" fill="none" stroke="#6366f1" stroke-width="6"/>
    <rect x="15" y="-35" width="50" height="35" rx="8" fill="none" stroke="#6366f1" stroke-width="6"/>
    <line x1="-15" y1="-20" x2="15" y2="-20" stroke="#6366f1" stroke-width="6"/>
    
    <!-- Confident Smile -->
    <path d="M-30,30 Q0,50 30,30" fill="none" stroke="#0f172a" stroke-width="5" stroke-linecap="round"/>
  </g>
  
  <!-- Monogram Overlay -->
  <rect x="250" y="660" width="300" height="70" rx="35" fill="#0f172a" stroke="url(#accentGrad)" stroke-width="2"/>
  <text x="400" y="705" font-family="system-ui, sans-serif" font-size="24" font-weight="800" fill="#f8fafc" text-anchor="middle" letter-spacing="2">RAHUL PARMAR</text>
</svg>
