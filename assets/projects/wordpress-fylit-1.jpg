<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="wpGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="badgeGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#21759b"/>
      <stop offset="100%" stop-color="#6366f1"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#wpGrad1)"/>
  <!-- UI Mockup Wireframe -->
  <rect x="50" y="40" width="700" height="420" rx="16" fill="#0b0f19" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <rect x="50" y="40" width="700" height="40" rx="16" fill="#1e293b"/>
  <circle cx="80" cy="60" r="6" fill="#ff5f56"/>
  <circle cx="100" cy="60" r="6" fill="#ffbd2e"/>
  <circle cx="120" cy="60" r="6" fill="#27c93f"/>
  <text x="400" y="65" font-family="sans-serif" font-size="14" fill="#94a3b8" text-anchor="middle">fylit.com.au — Tax Return Plugin & ACF Pro</text>
  
  <!-- Content Preview -->
  <rect x="90" y="110" width="300" height="24" rx="4" fill="url(#badgeGrad1)"/>
  <rect x="90" y="150" width="450" height="12" rx="3" fill="#334155"/>
  <rect x="90" y="170" width="380" height="12" rx="3" fill="#334155"/>
  
  <!-- Form Cards -->
  <rect x="90" y="210" width="280" height="180" rx="12" fill="#1e293b" stroke="#6366f1" stroke-width="1.5"/>
  <text x="110" y="245" font-family="sans-serif" font-size="16" font-weight="bold" fill="#f8fafc">Multi-Step Tax Form</text>
  <rect x="110" y="270" width="240" height="30" rx="6" fill="#0f172a"/>
  <rect x="110" y="310" width="240" height="30" rx="6" fill="#0f172a"/>
  <rect x="110" y="350" width="120" height="25" rx="6" fill="#6366f1"/>
  
  <!-- Stripe Badge Card -->
  <rect x="410" y="210" width="300" height="180" rx="12" fill="#1e293b" stroke="rgba(255,255,255,0.08)"/>
  <text x="430" y="245" font-family="sans-serif" font-size="16" font-weight="bold" fill="#38bdf8">Stripe & Referral System</text>
  <rect x="430" y="270" width="260" height="10" rx="2" fill="#334155"/>
  <rect x="430" y="290" width="220" height="10" rx="2" fill="#334155"/>
  <rect x="430" y="320" width="140" height="35" rx="8" fill="#10b981"/>
  <text x="500" y="342" font-family="sans-serif" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">Automated Pricing</text>
</svg>
