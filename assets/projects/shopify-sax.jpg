<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="shopifyGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b1120"/>
      <stop offset="100%" stop-color="#192a18"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#shopifyGrad1)"/>
  <rect x="50" y="40" width="700" height="420" rx="16" fill="#0f172a" stroke="rgba(150, 191, 72, 0.3)" stroke-width="2"/>
  <rect x="50" y="40" width="700" height="40" rx="16" fill="#1e293b"/>
  <circle cx="80" cy="60" r="6" fill="#ff5f56"/><circle cx="100" cy="60" r="6" fill="#ffbd2e"/><circle cx="120" cy="60" r="6" fill="#27c93f"/>
  <text x="400" y="65" font-family="sans-serif" font-size="14" fill="#96bf48" text-anchor="middle">saxhealthcare.com.au — Figma to Shopify Premium & Postcode Pricing</text>

  <!-- Shopify Healthcare Wireframe -->
  <rect x="90" y="100" width="620" height="60" rx="8" fill="#96bf48"/>
  <text x="120" y="138" font-family="sans-serif" font-size="20" font-weight="bold" fill="#000000">SAX HEALTHCARE STORE</text>

  <rect x="90" y="180" width="300" height="240" rx="10" fill="#1e293b"/>
  <text x="110" y="215" font-family="sans-serif" font-size="16" font-weight="bold" fill="#f8fafc">Customer Tag Dynamic Pricing</text>
  <rect x="110" y="235" width="260" height="35" rx="6" fill="#0f172a" stroke="#96bf48"/>
  <text x="125" y="258" font-family="sans-serif" font-size="12" fill="#96bf48">Tag: Healthcare Practitioner (-25%)</text>
  <rect x="110" y="285" width="260" height="110" rx="6" fill="#0f172a"/>

  <rect x="410" y="180" width="280" height="240" rx="10" fill="#1e293b"/>
  <text x="430" y="215" font-family="sans-serif" font-size="16" font-weight="bold" fill="#38bdf8">AU Postcode Validation</text>
  <rect x="430" y="240" width="240" height="40" rx="6" fill="#0f172a"/>
  <rect x="430" y="295" width="240" height="100" rx="6" fill="#0f172a"/>
</svg>
