<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <rect width="800" height="500" fill="#090d16"/>
  <rect x="50" y="40" width="700" height="420" rx="16" fill="#0f172a" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <rect x="50" y="40" width="700" height="40" rx="16" fill="#1e293b"/>
  <circle cx="80" cy="60" r="6" fill="#ff5f56"/><circle cx="100" cy="60" r="6" fill="#ffbd2e"/><circle cx="120" cy="60" r="6" fill="#27c93f"/>
  <text x="400" y="65" font-family="sans-serif" font-size="14" fill="#94a3b8" text-anchor="middle">marnie.com — WooCommerce Dashboard & Oxygen Builder</text>

  <!-- WooCommerce Dashboard Wireframe -->
  <rect x="90" y="100" width="180" height="320" rx="10" fill="#1e293b"/>
  <text x="110" y="135" font-family="sans-serif" font-size="16" font-weight="bold" fill="#f8fafc">My Account</text>
  <rect x="105" y="160" width="150" height="30" rx="6" fill="#6366f1"/>
  <rect x="105" y="200" width="150" height="30" rx="6" fill="#0f172a"/>
  <rect x="105" y="240" width="150" height="30" rx="6" fill="#0f172a"/>

  <rect x="290" y="100" width="420" height="320" rx="10" fill="#1e293b"/>
  <text x="310" y="135" font-family="sans-serif" font-size="18" font-weight="bold" fill="#38bdf8">Purchased Products (Custom Tabs)</text>
  <rect x="310" y="160" width="180" height="110" rx="8" fill="#0f172a"/>
  <rect x="510" y="160" width="180" height="110" rx="8" fill="#0f172a"/>
  <rect x="310" y="290" width="380" height="110" rx="8" fill="#0f172a"/>
</svg>
