<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <rect width="800" height="500" fill="#070a12"/>
  <rect x="50" y="40" width="700" height="420" rx="16" fill="#0f172a" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <rect x="50" y="40" width="700" height="40" rx="16" fill="#1e293b"/>
  <circle cx="80" cy="60" r="6" fill="#ff5f56"/><circle cx="100" cy="60" r="6" fill="#ffbd2e"/><circle cx="120" cy="60" r="6" fill="#27c93f"/>
  <text x="400" y="65" font-family="sans-serif" font-size="14" fill="#94a3b8" text-anchor="middle">velspices.com.au — Shopify Dawn Theme & Delivery Estimator</text>

  <!-- Velspices Wireframe -->
  <rect x="90" y="100" width="620" height="140" rx="10" fill="#1e293b"/>
  <text x="120" y="145" font-family="sans-serif" font-size="22" font-weight="bold" fill="#f8fafc">VELSPICES GROCERY STORE</text>
  <text x="120" y="175" font-family="sans-serif" font-size="14" fill="#f59e0b">Delivery Estimation App, Mega Menu & Dynamic Recommendations</text>

  <rect x="90" y="260" width="300" height="160" rx="10" fill="#1e293b"/>
  <text x="110" y="295" font-family="sans-serif" font-size="16" font-weight="bold" fill="#38bdf8">Delivery Time Estimation</text>
  <rect x="110" y="315" width="260" height="35" rx="6" fill="#0f172a" stroke="#f59e0b"/>
  <text x="125" y="338" font-family="sans-serif" font-size="12" fill="#f59e0b">Est. Delivery: 2-3 Business Days</text>

  <rect x="410" y="260" width="280" height="160" rx="10" fill="#1e293b"/>
  <text x="430" y="295" font-family="sans-serif" font-size="16" font-weight="bold" fill="#38bdf8">Recently Viewed Products</text>
  <rect x="430" y="315" width="240" height="85" rx="6" fill="#0f172a"/>
</svg>
